{
  "devDependencies": {
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint 'src/**/*.{js,ts,tsx}'",
    "security:secret-scan": "gitleaks detect --source . --verbose"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "git add"
    ]
  }
}