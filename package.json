{
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint 'src/**/*.{js,ts,tsx}' --no-error-on-unmatched-pattern",
    "lint:fix": "eslint 'src/**/*.{js,ts,tsx}' --fix",
    "security:secret-scan": "gitleaks detect --source . --verbose"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
